# Copy the relevant values into the ignored local .env only after resetting the
# staging database password. Never commit real Supabase credentials.

database.default.hostname = '<copy-session-pooler-host-from-supabase-connect>'
database.default.database = 'postgres'
database.default.username = '<copy-session-pooler-user-from-supabase-connect>'
database.default.password = '<store-only-in-local-env-or-secret-manager>'
database.default.DBDriver = 'Postgre'
database.default.port = 5432
database.default.schema = 'public'
database.default.encrypt = true
