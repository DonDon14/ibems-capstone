# Copy these keys into your untracked .env file. Never commit the Gmail app password.
email.fromEmail = "your-workspace-account@gmail.com"
email.fromName = "IBEMS Notifications"
email.protocol = "smtp"
email.SMTPHost = "smtp.gmail.com"
email.SMTPUser = "your-workspace-account@gmail.com"
email.SMTPPass = "your-16-character-google-app-password"
email.SMTPPort = 587
email.SMTPCrypto = "tls"
email.mailType = "html"
